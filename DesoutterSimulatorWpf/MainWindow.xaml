<Window
    x:Class="DesoutterSimulatorWpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:DesoutterSimulatorWpf.ViewModels"
    Title="Desoutter 拧紧枪模拟器"
    Width="900"
    Height="600">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,5"
            Orientation="Horizontal">
            <Button
                Margin="0,0,5,0"
                Command="{Binding AddGunCommand}"
                Content="添加枪" />
            <Button
                Margin="0,0,5,0"
                Command="{Binding RemoveGunCommand}"
                Content="移除枪" />
            <Button
                Margin="0,0,5,0"
                Command="{Binding SaveConfigCommand}"
                Content="保存配置" />
            <Button
                Margin="0,0,5,0"
                Command="{Binding LoadConfigCommand}"
                Content="加载配置" />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Guns}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="5"
                        Padding="5"
                        BorderBrush="Gray"
                        BorderThickness="1">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding Config.Name}" />
                            <TextBlock Text="{Binding Config.Port, StringFormat='端口: {0}'}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="状态: " />
                                <TextBlock Foreground="{Binding State.IsConnected, Converter={StaticResource BoolToColor}}" Text="{Binding State.IsConnected, Converter={StaticResource BoolToStatus}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="使能: " />
                                <TextBlock Text="{Binding State.IsEnabled}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="程序号: " />
                                <TextBlock Text="{Binding State.CurrentPsetId}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="订阅: " />
                                <TextBlock Text="{Binding State.LastSubscription}" />
                            </StackPanel>
                            <Button
                                Width="80"
                                Margin="0,5,0,0"
                                Command="{Binding StartCommand}"
                                Content="启动" />
                            <Button
                                Width="80"
                                Margin="0,2,0,0"
                                Command="{Binding StopCommand}"
                                Content="停止" />
                            <GroupBox Margin="0,10,0,0" Header="手动发送拧紧结果">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="VIN:" />
                                        <TextBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="5"
                                            Text="{Binding VIN}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="扭矩(Nm):" />
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="5"
                                            Text="{Binding Torque}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="角度(°):" />
                                        <TextBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="5"
                                            Text="{Binding Angle}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="程序号:" />
                                        <TextBox
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="5"
                                            Text="{Binding PsetId}" />
                                    </Grid>
                                    <Button
                                        Margin="0,5,0,0"
                                        Command="{Binding SendTighteningCommand}"
                                        Content="发送拧紧结果" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="就绪" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>